  "info": {
    "title": "API Financeiro",
    "description": "API para gerenciamento financeiro pessoal",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Marcos Silva",
            "description": "Nome completo do usuário"
          },
          "email": {
            "type": "string",
            "example": "marcos@email.com",
            "description": "E-mail único do usuário"
          },
          "password": {
            "type": "string",
            "example": "Forte@123",
            "description": "Senha forte: mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Marcos Silva"
          },
          "email": {
            "type": "string",
            "example": "marcos@email.com"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "AuthSessionDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access.payload.signature"
          },
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.payload.signature"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "example": 3600
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "marcos@email.com",
            "description": "E-mail de acesso"
          },
          "password": {
            "type": "string",
            "example": "Forte@123",
            "description": "Senha de acesso"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token JWT válido emitido no login ou registro",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh.payload.signature"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "LogoutResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Sessão encerrada com sucesso"
          }
        },
        "required": [
          "message"
        ]
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Alimentação",
            "description": "Nome da categoria"
          }
        },
        "required": [
          "name"
        ]
      },
      "CategoryResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Alimentação"
          },
          "userId": {
            "type": "number",
            "example": 1
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-03-25T10:00:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-03-25T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "userId",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Mercado",
            "description": "Novo nome da categoria"
          }
        },
        "required": [
          "name"
        ]
      },
      "DeleteCategoryResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Categoria removida com sucesso"
          }
        },
        "required": [
          "message"
        ]
      },
      "PaymentMethodResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Cartão de crédito"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-03-25T10:00:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-03-25T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateFinancialRecordDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Parcela notebook"
          },
          "type": {
            "type": "string",
            "enum": [
              "income",
              "expense"
            ],
            "example": "expense"
          },
          "amount": {
            "type": "number",
            "example": 350.5
          },
          "description": {
            "type": "string",
            "example": "Compra de notebook para trabalho"
          },
          "installmentsTotal": {
            "type": "number",
            "example": 12,
            "default": 1
          },
          "date": {
            "type": "string",
            "example": "2026-03-25T00:00:00.000Z"
          },
          "expireAt": {
            "type": "string",
            "example": "2026-04-10T00:00:00.000Z"
          },
          "categoryId": {
            "type": "number",
            "example": 1
          },
          "paymentMethodId": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "title",
          "type",
          "amount",
          "description",
          "installmentsTotal",
          "date",
          "categoryId",
          "paymentMethodId"
        ]
      },
      "FinancialRecordResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Parcela notebook"
          },
          "type": {
            "type": "string",
            "example": "expense"
          },
          "amount": {
            "type": "number",
            "example": 350.5
          },
          "description": {
            "type": "string",
            "example": "Compra de notebook para trabalho"
          },
          "installmentsTotal": {
            "type": "number",
            "example": 12
          },
          "installmentNumber": {
            "type": "number",
            "example": 1
          },
          "installmentGroup": {
            "type": "string",
            "example": "f2095cb2-657f-4cc6-b214-0bf85904ca40"
          },
          "date": {
            "format": "date-time",
            "type": "string",
            "example": "2026-03-25T00:00:00.000Z"
          },
          "expireAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-04-10T00:00:00.000Z"
          },
          "paid": {
            "type": "boolean",
            "example": false
          },
          "paidAt": {
            "type": "object",
            "example": null
          },
          "categoryId": {
            "type": "number",
            "example": 1
          },
          "paymentMethodId": {
            "type": "number",
            "example": 1
          },
          "userId": {
            "type": "number",
            "example": 1
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-03-25T00:00:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-03-25T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "amount",
          "description",
          "installmentsTotal",
          "installmentNumber",
          "date",
          "paid",
          "categoryId",
          "paymentMethodId",
          "userId",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateFinancialRecordDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Parcela notebook"
          },
          "type": {
            "type": "string",
            "enum": [
              "income",
              "expense"
            ],
            "example": "expense"
          },
          "amount": {
            "type": "number",
            "example": 350.5
          },
          "description": {
            "type": "string",
            "example": "Compra de notebook para trabalho"
          },
          "date": {
            "type": "string",
            "example": "2026-03-25T00:00:00.000Z"
          },
          "expireAt": {
            "type": "string",
            "example": "2026-04-10T00:00:00.000Z"
          },
          "categoryId": {
            "type": "number",
            "example": 1
          },
          "paymentMethodId": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "title",
          "type",
          "amount",
          "description",
          "date",
          "categoryId",
          "paymentMethodId"
        ]
      },
      "DeleteFinancialRecordResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Lançamento financeiro removido com sucesso"
          }
        },
        "required": [
          "message"
        ]
      }
